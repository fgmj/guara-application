# Banco de dados (docker compose sobe o Postgres em localhost:5432)
DATABASE_URL="postgresql://guara:guara@localhost:5432/guara?schema=public"

# Auth.js — gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-aleatorio"
# Em produção atrás de proxy/domínio próprio
AUTH_TRUST_HOST=true

# Usuário administrador criado pelo seed (npm run db:seed)
SEED_ADMIN_EMAIL="admin@guara.local"
SEED_ADMIN_PASSWORD="troque-esta-senha"
