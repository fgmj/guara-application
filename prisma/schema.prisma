generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// GESTOR vê todas as filiais e os consolidados; FUNCIONARIO só lança nas filiais vinculadas.
enum Role {
  ADMIN
  GESTOR
  FUNCIONARIO
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(FUNCIONARIO)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  filiais      Filial[]

  @@map("users")
}

model Filial {
  id           String            @id @default(cuid())
  nome         String            @unique
  ativo        Boolean           @default(true)
  createdAt    DateTime          @default(now())
  usuarios     User[]
  entregadores Entregador[]
  formas       FormaRecebimento[]
  vendas       Venda[]
  compras      Compra[]
  vales        Vale[]
  despesas     Despesa[]
  caixas       CaixaDia[]
  ajustes      AjusteEstoque[]

  @@map("filiais")
}

enum ProdutoTipo {
  GAS /// botijão cheio: compra entra, venda sai
  VASILHAME /// casco: altera o total de vasilhames do produto base
  OUTRO /// sem controle de estoque (serviços, kit, água)
}

model Produto {
  id      String      @id @default(cuid())
  nome    String      @unique
  tipo    ProdutoTipo @default(GAS)
  /// Para VASILHAME: o produto de gás correspondente.
  baseId  String?
  base    Produto?    @relation("Vasilhame", fields: [baseId], references: [id])
  cascos  Produto[]   @relation("Vasilhame")
  /// Custo de compra por unidade (base do resultado bruto e valor sugerido da compra).
  custo   Decimal     @default(0) @db.Decimal(12, 2)
  /// Preços de venda sugeridos, separados por vírgula.
  precos  String      @default("")
  ordem   Int         @default(0)
  ativo   Boolean     @default(true)
  vendas  Venda[]
  compras Compra[]
  ajustes AjusteEstoque[]

  @@map("produtos")
}

/// Canal de venda (PEDIDOS, PORTARIA, COMÉRCIO...). TROCA/TRANSFERÊNCIA não contam como receita.
model CategoriaVenda {
  id          String  @id @default(cuid())
  nome        String  @unique
  contaReceita Boolean @default(true)
  ordem       Int     @default(0)
  ativo       Boolean @default(true)
  vendas      Venda[]

  @@map("categorias_venda")
}

model Entregador {
  id       String  @id @default(cuid())
  nome     String
  filialId String
  filial   Filial  @relation(fields: [filialId], references: [id])
  ativo    Boolean @default(true)
  vendas   Venda[]

  @@unique([filialId, nome])
  @@map("entregadores")
}

model Venda {
  id           String         @id @default(cuid())
  filialId     String
  filial       Filial         @relation(fields: [filialId], references: [id])
  data         DateTime       @db.Date
  categoriaId  String
  categoria    CategoriaVenda @relation(fields: [categoriaId], references: [id])
  entregadorId String?
  entregador   Entregador?    @relation(fields: [entregadorId], references: [id])
  produtoId    String
  produto      Produto        @relation(fields: [produtoId], references: [id])
  quantidade   Int
  valorUnit    Decimal        @db.Decimal(12, 2)
  total        Decimal        @db.Decimal(12, 2)
  obs          String?
  criadoPor    String?
  createdAt    DateTime       @default(now())

  @@index([filialId, data])
  @@map("vendas")
}

model Compra {
  id         String    @id @default(cuid())
  filialId   String
  filial     Filial    @relation(fields: [filialId], references: [id])
  data       DateTime  @db.Date
  produtoId  String
  produto    Produto   @relation(fields: [produtoId], references: [id])
  quantidade Int
  valor      Decimal   @default(0) @db.Decimal(12, 2)
  fornecedor String?
  pagamento  String? /// Boleto, Tag, À vista...
  vencimento DateTime? @db.Date
  pagoEm     DateTime? @db.Date
  nota       String?
  obs        String?
  criadoPor  String?
  createdAt  DateTime  @default(now())

  @@index([filialId, data])
  @@map("compras")
}

enum ValeRecebimento {
  CAIXA /// recebido no caixa do dia
  CONTA /// pix/transferência direto na conta
  DESCONTO /// descontado do pagamento do funcionário
}

/// Venda fiada ou adiantamento: sai do caixa no dia e volta quando é recebido.
model Vale {
  id           String           @id @default(cuid())
  filialId     String
  filial       Filial           @relation(fields: [filialId], references: [id])
  data         DateTime         @db.Date
  descricao    String
  valor        Decimal          @db.Decimal(12, 2)
  recebidoEm   DateTime?        @db.Date
  recebimento  ValeRecebimento?
  obs          String?
  criadoPor    String?
  createdAt    DateTime         @default(now())

  @@index([filialId, data])
  @@index([filialId, recebidoEm])
  @@map("vales")
}

model CategoriaDespesa {
  id       String    @id @default(cuid())
  nome     String    @unique
  ativo    Boolean   @default(true)
  despesas Despesa[]

  @@map("categorias_despesa")
}

enum DespesaOrigem {
  CAIXA
  CARTAO
  CONTA
}

model Despesa {
  id           String           @id @default(cuid())
  filialId     String
  filial       Filial           @relation(fields: [filialId], references: [id])
  data         DateTime         @db.Date
  descricao    String
  categoriaId  String
  categoria    CategoriaDespesa @relation(fields: [categoriaId], references: [id])
  subcategoria String?
  valor        Decimal          @db.Decimal(12, 2)
  origem       DespesaOrigem    @default(CAIXA)
  placa        String?
  km           Int?
  criadoPor    String?
  createdAt    DateTime         @default(now())

  @@index([filialId, data])
  @@map("despesas")
}

enum FormaGrupo {
  CARTAO
  DINHEIRO
  PIX
  OUTRO
}

/// Colunas do caixa de cada filial (maquininhas, dinheiro, pix...).
model FormaRecebimento {
  id       String      @id @default(cuid())
  filialId String
  filial   Filial      @relation(fields: [filialId], references: [id])
  nome     String
  grupo    FormaGrupo  @default(CARTAO)
  ordem    Int         @default(0)
  ativo    Boolean     @default(true)
  itens    CaixaItem[]

  @@unique([filialId, nome])
  @@map("formas_recebimento")
}

model CaixaDia {
  id        String      @id @default(cuid())
  filialId  String
  filial    Filial      @relation(fields: [filialId], references: [id])
  data      DateTime    @db.Date
  fechado   Boolean     @default(false)
  obs       String?
  fechadoPor String?
  itens     CaixaItem[]

  @@unique([filialId, data])
  @@map("caixas")
}

model CaixaItem {
  id      String           @id @default(cuid())
  caixaId String
  caixa   CaixaDia         @relation(fields: [caixaId], references: [id], onDelete: Cascade)
  formaId String
  forma   FormaRecebimento @relation(fields: [formaId], references: [id])
  valor   Decimal          @db.Decimal(12, 2)

  @@unique([caixaId, formaId])
  @@map("caixa_itens")
}

/// Contagem/ajuste: delta de cheios (produto GAS) ou do total de vasilhames (produto VASILHAME).
model AjusteEstoque {
  id         String   @id @default(cuid())
  filialId   String
  filial     Filial   @relation(fields: [filialId], references: [id])
  data       DateTime @db.Date
  produtoId  String
  produto    Produto  @relation(fields: [produtoId], references: [id])
  quantidade Int
  motivo     String?
  criadoPor  String?
  createdAt  DateTime @default(now())

  @@index([filialId, data])
  @@map("ajustes_estoque")
}
